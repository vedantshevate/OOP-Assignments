#include <iostream>

using namespace std;

class student
{
public:
    string name;
    int rollno;
    int marks;

    void display()
    {
        cout << "------- Student Detail ------" << endl;
        cout << "Name: " << name << endl;
        cout << "Roll No: " << rollno << endl;
        cout << "Marks: " << marks << endl;
    }

    void input()
    {
        cout << "Enter the Name: ";
        cin >> name;

        cout << "Enter the Roll No: ";
        cin >> rollno;

        cout << "Enter the Marks: ";
        cin >> marks;
    }
};

int main()
{
    student s1;
    student s2;

    s1.input();
    s2.input();

    s1.display();
    s2.display();

    return 0;
}
